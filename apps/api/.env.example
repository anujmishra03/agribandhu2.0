# AgriBandhu Backend Environment Variables
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_characters

# Database (Default SQLite for local dev, or Neon/Supabase PostgreSQL URL for production)
DATABASE_URL="file:./dev.db"

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth (for "Sign in with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <FRONTEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret
# Optional: override the callback URL (defaults to <FRONTEND_URL>/api/auth/google/callback)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Admin seed account (used by `pnpm seed`)
ADMIN_EMAIL=itachimishra2@gmail.com
ADMIN_PASSWORD=Anujmishra2319
ADMIN_NAME=Itachi Mishra
